		(net
			(code "45")
			(name "~{Interrupt}")
			(class "Default")
			(node
				(ref "IC2")
				(pin "5")
				(pinfunction "1Q_5")
				(pintype "output")
			)
			(node
				(ref "J1")
				(pin "29")
				(pintype "passive")
			)
		)
		(net
			(code "46")
			(name "~{Reset}")
			(class "Default")
			(node
				(ref "IC7")
				(pin "9")
				(pinfunction "3A_9")
				(pintype "input")
			)
			(node
				(ref "J1")
				(pin "32")
				(pintype "passive")
			)
		)
		(net
			(code "47")
			(name "~{Set Interrupt on CLK}")
			(class "Default")
			(node
				(ref "IC2")
				(pin "2")
				(pinfunction "1D_2")
				(pintype "input")
			)
			(node
				(ref "J1")
				(pin "4")
				(pintype "passive")
			)
		)
	)
)
